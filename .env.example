EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional — leave blank to disable. Get a DSN from sentry.io (free tier is
# fine for a project this size): Settings > Projects > (create one) > Client Keys (DSN).
EXPO_PUBLIC_SENTRY_DSN=

# Optional — leave blank to disable the sign-up form's CAPTCHA widget (web
# only). Get a free site key from the Cloudflare dashboard: Turnstile > Add
# site. The matching secret key does NOT go here — set it as the
# TURNSTILE_SECRET_KEY Edge Function secret instead (Supabase dashboard >
# Edge Functions > Manage secrets), never in client-side env vars.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
